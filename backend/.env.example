APP_NAME=SmogShield AI Backend
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Explicit Demo Mode (false = live providers only; true = explicit offline test demo data)
DEMO_MODE=false

# Google Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Operator Smoke-Test Authentication Token (strictly separate from GEMINI_API_KEY)
# Used via X-Operator-Token header on POST /api/v1/assistant/smoke-test
ASSISTANT_SMOKE_TEST_TOKEN=

# Optional Trusted Reverse Proxy IPs for secure X-Forwarded-For parsing
TRUSTED_PROXY_IPS=[]

# Official data.gov.in CPCB Real-time AQI API
# Obtain key at: https://data.gov.in
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource

# OpenAQ API v3 (Header: X-API-Key)
# Obtain key at: https://openaq.org
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3

# HTTP Client Settings
HTTP_TIMEOUT_SECONDS=10.0
HTTP_MAX_RETRIES=2

# Freshness Policy Thresholds (Hours)
FRESH_THRESHOLD_HOURS=4.0
STALE_THRESHOLD_HOURS=24.0
